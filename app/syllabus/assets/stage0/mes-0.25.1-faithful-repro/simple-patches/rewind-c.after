#include <mes/lib.h>
#include <errno.h>
#include <stdio.h>

/* This was a stub that did nothing, so any program that reads a few bytes
   and then rewinds (readelf's archive-signature probe) kept reading from
   the wrong offset.  Mes's FILE is the file descriptor, and fseek on it
   already discards the read buffer. */
void
rewind (FILE * stream)
{
  fseek (stream, 0L, SEEK_SET);
  errno = 0;
}
