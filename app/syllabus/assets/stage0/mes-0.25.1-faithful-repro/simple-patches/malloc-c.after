#include <mes/lib.h>
#include <string.h>
#include <stddef.h>
#include <stdint.h>

char *__brk = 0;

#if __TINYC__
/* The allocator below never reuses memory: free is a no-op and realloc always
   takes fresh memory.  Programs with heavy allocate/free churn (GNU make's
   implicit rule search, ld) then grow without bound; make reached 22 GB and
   was OOM-killed.  For TinyCC builds use power-of-two size classes with
   per-class free lists.  Every block has a 16-byte header holding its class,
   so payloads stay 16-byte aligned.  Not thread safe, like the rest of Mes. */
#define __MALLOC_HDR 16
#define __MALLOC_CLASSES 48
void *__malloc_free_lists[__MALLOC_CLASSES];

void *
malloc (size_t size)
{
  int c = 4;
  if (size == 0)
    size = 1;
  while (c < __MALLOC_CLASSES && ((size_t) 1 << c) < size)
    c++;
  if (c >= __MALLOC_CLASSES)
    return 0;
  if (__malloc_free_lists[c])
    {
      void *p = __malloc_free_lists[c];
      __malloc_free_lists[c] = *(void **) p;
      return p;
    }
  if (!__brk)
    __brk = cast_long_to_charp (brk (0));
  __brk = (char *) (((uintptr_t) __brk + __MALLOC_HDR - 1) & -(uintptr_t) __MALLOC_HDR);
  char *block = __brk;
  size_t total = __MALLOC_HDR + ((size_t) 1 << c);
  if (brk (block + total) == -1)
    return 0;
  __brk = block + total;
  *(size_t *) block = c;
  return block + __MALLOC_HDR;
}
#else

void *
malloc (size_t size)
{
  if (!__brk)
    __brk = cast_long_to_charp (brk (0));
#if !__M2__
  /* align what we give back. */
  __brk = (char*) (((uintptr_t) __brk
                    + sizeof (max_align_t) - 1) & -sizeof (max_align_t));
#endif
  if (brk (__brk + size) == -1)
    return 0;
  char *p = __brk;
  __brk = __brk + size;
  return p;
}
#endif // ! __TINYC__
