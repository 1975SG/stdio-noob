#include <stdio.h>

#include <stdio.h>
#include <unistd.h>

/* The old version (fclose, then fopen) only redirected stdout by accident:
   open() reused the lowest free descriptor, 1.  fopen now moves descriptors
   0..2 out of the way (a FILE * is the descriptor, so 0 would be NULL), so
   keep a standard stream on its own descriptor with dup2. */
FILE *
freopen (char const *file_name, char const *opentype, FILE * stream)
{
  int fd = (int) (long) stream;
  if (fd >= 0 && fd <= 2)
    {
      FILE *opened = fopen (file_name, opentype);
      if (opened == 0)
        return 0;
      int nfd = (int) (long) opened;
      if (nfd != fd)
        {
          dup2 (nfd, fd);
          close (nfd);
        }
      return stream;
    }
  fclose (stream);
  return fopen (file_name, opentype);
}
