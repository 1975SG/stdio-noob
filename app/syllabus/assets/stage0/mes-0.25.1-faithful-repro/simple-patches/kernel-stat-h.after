#ifndef __MES_LINUX_X86_64_KERNEL_STAT_H
#define __MES_LINUX_X86_64_KERNEL_STAT_H 1

// https://github.com/torvalds/linux/blob/master/arch/x86/include/uapi/asm/stat.h

// *INDENT-OFF*
struct stat
{
  unsigned long	st_dev;
  unsigned long	st_ino;
  unsigned long	st_nlink;
  unsigned int	st_mode;
  unsigned int	st_uid;
  unsigned int	st_gid;
  unsigned int	__pad0;
  unsigned long	st_rdev;
  unsigned long	st_size;
  /* st_blksize and st_blocks come BEFORE the timestamps in the kernel's
     struct stat (asm/stat.h).  They were listed after them, so st_mtime read
     the kernel's atime, st_blksize its ctime, and the struct was 152 bytes
     instead of 144.  make saw stale mtimes; opendir() asked calloc for
     ~1.7 GB because st_blksize was a timestamp. */
  unsigned long	st_blksize;
  long		st_blocks;
  unsigned long	st_atime;
  unsigned long	st_atime_nsec;
  unsigned long	st_mtime;
  unsigned long	st_mtime_nsec;
  unsigned long	st_ctime;
  unsigned long	st_ctime_nsec;
  long		__unused[3];
};

#endif // __MES_LINUX_X86_64_KERNEL_STAT_H
