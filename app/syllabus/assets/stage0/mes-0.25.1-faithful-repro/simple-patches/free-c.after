#include <stdlib.h>

#include <stddef.h>

#if __TINYC__
extern void *__malloc_free_lists[];

void
free (void *ptr)
{
  if (ptr == 0)
    return;
  size_t c = *(size_t *) ((char *) ptr - 16);
  *(void **) ptr = __malloc_free_lists[c];
  __malloc_free_lists[c] = ptr;
}
#else
void
free (void *ptr)
{
}
#endif // ! __TINYC__
