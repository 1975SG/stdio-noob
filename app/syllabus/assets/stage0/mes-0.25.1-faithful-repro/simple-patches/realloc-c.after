#include <stdlib.h>
#include <string.h>

#include <stddef.h>

#if __TINYC__
void *
realloc (void *ptr, size_t size)
{
  if (ptr == 0)
    return malloc (size);
  size_t capacity = (size_t) 1 << *(size_t *) ((char *) ptr - 16);
  if (size <= capacity)
    return ptr;
  void *new = malloc (size);
  if (new != 0)
    {
      memcpy (new, ptr, capacity);
      free (ptr);
    }
  return new;
}
#else
void *
realloc (void *ptr, size_t size)
{
  void *new = malloc (size);
  if (ptr != 0 && new != 0)
    {
      memcpy (new, ptr, size);
      free (ptr);
    }
  return new;
}
#endif // ! __TINYC__
