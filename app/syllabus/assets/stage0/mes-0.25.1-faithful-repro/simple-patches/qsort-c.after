#include <stdlib.h>
#include <string.h>

/* The previous implementation was a quicksort that treated an element equal
   to the pivot as "already in place" without moving it, so any array with
   duplicate keys came back unsorted (linking with ld sorts sections that share
   an address).  This is a bottom-up merge sort: correct for duplicates,
   stable, and O(n log n); if the scratch buffer cannot be allocated it falls
   back to an insertion sort. */

static void
qsort_insertion (char *base, size_t count, size_t size,
                 int (*compare) (void const *, void const *))
{
  for (size_t i = 1; i < count; i++)
    {
      size_t j = i;
      while (j > 0 && compare (base + (j - 1) * size, base + j * size) > 0)
        {
          char *pa = base + (j - 1) * size;
          char *pb = base + j * size;
          for (size_t k = 0; k < size; k++)
            {
              char tmp = pa[k];
              pa[k] = pb[k];
              pb[k] = tmp;
            }
          j--;
        }
    }
}

void
qsort (void *base, size_t count, size_t size, int (*compare) (void const *, void const *))
{
  if (count < 2 || size == 0)
    return;
  char *tmp = malloc (count * size);
  if (tmp == 0)
    {
      qsort_insertion (base, count, size, compare);
      return;
    }
  char *src = base;
  char *dst = tmp;
  for (size_t width = 1; width < count; width *= 2)
    {
      for (size_t lo = 0; lo < count; lo += 2 * width)
        {
          size_t mid = lo + width < count ? lo + width : count;
          size_t hi = lo + 2 * width < count ? lo + 2 * width : count;
          size_t i = lo;
          size_t j = mid;
          size_t k = lo;
          while (i < mid && j < hi)
            {
              if (compare (src + i * size, src + j * size) <= 0)
                {
                  memcpy (dst + k * size, src + i * size, size);
                  i++;
                }
              else
                {
                  memcpy (dst + k * size, src + j * size, size);
                  j++;
                }
              k++;
            }
          if (i < mid)
            memcpy (dst + k * size, src + i * size, (mid - i) * size);
          else if (j < hi)
            memcpy (dst + k * size, src + j * size, (hi - j) * size);
        }
      char *t = src;
      src = dst;
      dst = t;
    }
  if (src != (char *) base)
    memcpy (base, src, count * size);
  free (tmp);
}
